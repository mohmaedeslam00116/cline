{
	"name": "@lens/ports",
	"version": "0.1.0",
	"description": "Hexagonal port interfaces and capability-grant model for LENS Workstation (dependency-free)",
	"repository": {
		"type": "git",
		"url": "https://github.com/mohmaedeslam00116/cline",
		"directory": "lens/packages/ports"
	},
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": ["dist"],
	"scripts": {
		"build": "bun tsc --project tsconfig.json",
		"typecheck": "bun tsc --noEmit",
		"test": "bun run test:unit",
		"test:unit": "bun test src"
	},
	"engines": {
		"node": ">=22"
	},
	"dependencies": {}
}
